---
// Starlight's footer identifies the rolling fork by its source commit.
import Default from "@astrojs/starlight/components/Footer.astro";
---

<Default><slot /></Default>
<p class="version">
    Rolling fork · <a href={`${__POCKET_GITHUB__}/tree/${__POCKET_REF__}`}>
        source {__POCKET_REF__.slice(0, 12)}</a
    >.
    Upstream package metadata: {__POCKET_VERSION__}, not a fork release version.
    Your checkout includes its own <code>docs/</code> folder.
</p>

<style>
    .version {
        margin-top: 1.5rem;
        font-size: var(--sl-text-xs);
        color: var(--sl-color-gray-3);
    }
</style>
